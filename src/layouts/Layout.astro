---
// stylesheet
import "../styles/global.css";

// components
import BaseHead from "../components/global/BaseHead.astro";
import Wrapper from "../components/global/Wrapper.astro";
import NavBar from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

// assets
import bg from "../assets/images/bg.jpg";
import { getImage } from "astro:assets";

const backgroundImage = await getImage({
	src: bg,
	format: "jpg"
});

// props
const {
	title = "Mudrik Jundullah | Data Science Portfolio",
	description = "Data Science portfolio featuring Machine Learning, Data Analytics, Data Visualization, and Data Engineering projects.",
	titleTemplate = "%s | Mudrik Jundullah",
	siteName = "Mudrik Jundullah",
	ogImage,
	twitterSite,
	themeColor,
	locale = "en_US",
	...seoProps
} = Astro.props;

// Open Graph image
const defaultOgImage = new URL(
	"/og-image.png",
	Astro.site
).toString();

const finalOgImage = ogImage || defaultOgImage;
---

<!doctype html>
<html lang="en" class="scroll-smooth">

	<BaseHead
		title={title}
		description={description}
		titleTemplate={titleTemplate}
		siteName={siteName}
		ogImage={finalOgImage}
		twitterSite={twitterSite}
		themeColor={themeColor}
		locale={locale}
		{...seoProps}
	/>

	<body
		style={`background-image: url(${backgroundImage.src})`}
		class="bg-cover bg-center bg-no-repeat bg-fixed box-border"
	>
		<!-- Background noise effect -->
		<div class="noise-[67,22,25] fixed inset-0 pointer-events-none"></div>

		<!-- Wrapper component to make sure all content on the website is above the noise filter background -->
		<Wrapper>
			<NavBar />

			<main class="flex flex-col xl:gap-48 lg:gap-40 gap-28">
				<slot />
			</main>

			<Footer />
		</Wrapper>
	</body>

</html>