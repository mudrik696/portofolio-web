---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter from "../../../assets/images/mudrik2.jpeg";
---

<Container variant={'xl'}>
    <Heading tagName="h1" tagSize="h1" class="text-center">Meet Mudrik</Heading>
    <div class="flex md:flex-row flex-col gap-16 md:items-center">
<div class="flex-1 flex flex-col gap-7">
    <Text variant={'xl'} class="text-base-900">I'm a Data Science student who enjoys transforming data into insights, predictions, and practical solutions.</Text>
    <Text variant={'sm'} class="text-base-900">I work across machine learning, data analytics, visualization, and data engineering. From exploring and preparing datasets to developing models, building dashboards, and designing data pipelines, I approach each project with curiosity, analytical thinking, and a focus on solving meaningful problems.</Text>
</div>

        <div class="flex-1 md:h-[500px] w-full">
            <ImageContainer src={peter} alt="Peter"/>
        </div>
    </div>
</Container>